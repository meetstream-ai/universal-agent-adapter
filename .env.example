ADAPTER_API_KEY=
MIA_BRIDGE_TOKEN=
MEETSTREAM_API_KEY=
# Required for npm start -- --runtime openai, or --allow-openai switches.
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=
SPEECH_API_KEY=
MEETSTREAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
NGROK_AUTHTOKEN=
AGENT_RUNTIME=openai
# Optional explicit AGENT_MODEL override.
# LangGraph with native Gemini: MODEL_PROVIDER=google, AGENT_MODEL=gemini-3.5-flash-lite.
# Default MODEL_PROVIDER=openai; Google uses GOOGLE_API_KEY, with no fallback.
# NGROK_AUTHTOKEN is optional for an explicitly started local test tunnel.
# Optional shared input: TRANSCRIPT_SOURCE=deepgram (default: meetstream).
# Optional shared speech: SPEECH_PROVIDER=deepgram, SPEECH_MODEL=aura-2-thalia-en.
# Or: SPEECH_PROVIDER=gemini, SPEECH_MODEL=gemini-3.8-flash-tts, SPEECH_VOICE=Kore.
# Never commit .env or session callback tokens.
